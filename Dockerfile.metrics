
FROM evoapicloud/evolution-api:v2.3.7 AS base

WORKDIR /evolution

COPY tsconfig.json tsup.config.ts package.json ./
COPY src ./src

RUN npm run build

# Gera o Prisma Client durante a construção da imagem
RUN DATABASE_PROVIDER=postgresql npm run db:generate


FROM evoapicloud/evolution-api:v2.3.7 AS final

WORKDIR /evolution

# Código recompilado
COPY --from=base /evolution/dist ./dist

# Scripts atualizados
COPY --from=base /evolution/package.json ./package.json

# Prisma Client gerado na etapa de construção
COPY --from=base /evolution/node_modules/.prisma ./node_modules/.prisma

# Migrações e inicialização
ENTRYPOINT ["/bin/bash", "-c", "export DATABASE_URL=\"${DATABASE_URL:-$DATABASE_CONNECTION_URI}\"; if [ -z \"$DATABASE_URL\" ]; then echo 'ERRO: DATABASE_URL nao configurada'; exit 1; fi; npm run db:deploy && exec npm run start:prod"]
